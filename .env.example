# MundoPeludo Configuration
PORT=3000
FASTAPI_PORT=8001
FASTAPI_HOST=127.0.0.1
NODE_ENV=development

# === BACKEND FASTAPI (arquitectura hexagonal) ===
# Ruta de la base SQLite. Por defecto: backend/data/mundopeludo.db
# MP_DB_PATH=
MP_SECRET_KEY=genera-una-clave-larga-y-aleatoria
MP_TOKEN_MINUTES=720
MP_CORS_ORIGINS=*
# 1 = API cerrada: token, rol y propiedad del recurso (valor por defecto).
# 0 = API abierta, sin permisos; sólo para desarrollo local.
MP_REQUIRE_AUTH=1
MP_ENV=desarrollo

# === CORREO SALIENTE (notificaciones) ===
# Sin MP_EMAIL_HOST no se envía nada.
MP_EMAIL_HOST=smtp.gmail.com
MP_EMAIL_PORT=587
MP_EMAIL_USE_TLS=1
MP_EMAIL_USER=tu-cuenta@gmail.com
MP_EMAIL_PASSWORD="contraseña de aplicación de Google"
MP_EMAIL_FROM="MundoPeludo - Sistema de notificaciones <tu-cuenta@gmail.com>"
# Sólo desarrollo: manda TODOS los correos a esta dirección (el destinatario
# real va en el asunto). Con MP_ENV=produccion la app no arranca si está puesta.
# MP_EMAIL_REDIRIGIR_A=tu-cuenta@gmail.com
